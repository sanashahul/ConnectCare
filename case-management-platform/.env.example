# Copy to .env and fill in. Never commit .env.

# Postgres connection string. In production use a managed Postgres with
# encryption at rest and TLS (add ?sslmode=require).
DATABASE_URL=postgres://connectcare:devpassword@localhost:5432/connectcare

# 32-byte key, base64. Generate with: npm run generate-key
# Encrypts client names, contact info, notes, and care plan text inside the database.
# Store it in your host's secret manager. If it is lost, encrypted data cannot be recovered.
DATA_ENCRYPTION_KEY=

# Name shown in the authenticator app (Google Authenticator, Duo, etc.)
TOTP_ISSUER=ConnectCare

# Minutes of inactivity before a staff member is signed out.
SESSION_IDLE_MINUTES=30

# --- AI resource assistant (OFF by default) ---
# Leave false until your privacy office has approved the AI vendor agreement.
# Even when on, the app never sends names, contact details, or case notes. See PRIVACY.md.
AI_ENABLED=false
ANTHROPIC_API_KEY=
# Let the assistant search the public web for resources missing from the directory.
AI_WEB_SEARCH=true
